    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "AI Medical Report Analysis",
        "message": "=<h2>Medical Report Analysis</h2>\n\n<p><b>Patient:</b> {{$node[\"Get Patient\"].json.full_name}}</p>\n\n<h3>Summary</h3>\n<p>{{$node[\"Code in JavaScript\"].json.summary}}</p>\n\n<h3>Possible Condition</h3>\n<p>{{$node[\"Code in JavaScript\"].json.possible_condition}}</p>\n\n<h3>Severity</h3>\n<p>{{$node[\"Code in JavaScript\"].json.severity}}</p>\n\n<h3>Recommended Department</h3>\n<p>{{$node[\"Code in JavaScript\"].json.recommended_department}}</p>\n\n<h3>Recommendations</h3>\n<p>{{$node[\"Code in JavaScript\"].json.recommendation}}</p>\n\n<h3>Recommended Tests</h3>\n\n<ul>\n<li>{{$node[\"Code in JavaScript\"].json.recommended_tests[0]}}</li>\n<li>{{$node[\"Code in JavaScript\"].json.recommended_tests[1]}}</li>\n<li>{{$node[\"Code in JavaScript\"].json.recommended_tests[2]}}</li>\n</ul>\n\n<hr>\n\n<p><b>This AI report is preliminary and should not replace consultation with a licensed healthcare professional.</b></p>",
        "options": {}
      },
