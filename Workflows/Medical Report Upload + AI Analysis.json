        "options": {}
      },
      "id": "5ff0c5ee-fc9e-453b-bd68-0b8b9f5657a4",
      "name": "Extract from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        272,
        -80
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=You are an experienced medical AI assistant helping doctors perform a preliminary assessment.\n\nIMPORTANT:\n- This is only a preliminary AI assessment.\n- Do NOT claim to have interpreted the uploaded PDF.\n- Base your analysis ONLY on the patient information provided below.\n- If information is missing, clearly mention that it is unavailable.\n- Never fabricate findings.\n- Return ONLY valid JSON.\n- Do NOT include markdown or ```json.\n\nPATIENT DETAILS\n\nPatient Name:\n{{ $('Get Patient').item.json.full_name }}\n\nAge:\n{{ $('Get Patient').item.json.age }}\n\nGender:\n{{ $('Get Patient').item.json.gender }}\n\nBlood Group:\n{{ $('Get Patient').item.json.blood_group }}\n\nMedical History:\n{{ $('Get Patient').item.json.medical_history }}\n\nAllergies:\n{{ $('Get Patient').item.json.allergies }}\n\nCurrent Medications:\n{{ $('Get Patient').item.json.medications }}\n\nPrevious Symptoms:\n{{ $('Get Patient').item.json.symptoms }}\n\nPrevious AI Assessment:\n\n\nReport Type:\n{{ $('On form submission').item.json[\"Report Type\"] }}\n\nCurrent Symptoms / Notes:\n{{ $('On form submission').item.json[\"Additional Symptoms / Notes\"] }}\n\nProvide a preliminary assessment in this EXACT JSON format:\n\n{\n  \"summary\": \"\",\n  \"possible_condition\": \"\",\n  \"severity\": \"\",\n  \"recommended_department\": \"\",\n  \"recommended_tests\": [\n    \"\",\n    \"\",\n    \"\"\n  ],\n  \"recommendation\": \"\"\n}\n\nRules:\n- summary should be 2-4 sentences.\n- possible_condition should be the most likely condition based only on the available information.\n- severity must be one of:\n  Low\n  Moderate\n  High\n- recommended_department should be the most appropriate department.\n- recommended_tests should contain 3 recommended investigations.\n- recommendation should be a short paragraph explaining the next steps.\n- If information is insufficient, clearly state that additional clinical evaluation is required.\n- Return ONLY the JSON object."
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "295d66ac-5ca3-41f0-8bd6-17b3bf9c3129",
      "name": "Message a model",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        640,
        96
      ],
      "credentials": {
        "googlePalmApi": {
          "id": "VCUQdZ1UbtfaEOTx",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Read Gemini response\nconst response = $json.content.parts[0].text;\n\n// Remove markdown if present\nconst cleaned = response\n  .replace(/```json/g, \"\")\n  .replace(/```/g, \"\")\n  .trim();\n\nlet ai;\n\ntry {\n  ai = JSON.parse(cleaned);\n} catch (e) {\n  // If Gemini didn't return JSON, save the text instead\n  ai = {\n    summary: cleaned,\n    possible_condition: \"\",\n    severity: \"\",\n    recommended_department: \"\",\n    recommended_tests: [],\n    recommendation: \"\"\n  };\n}\n\nreturn {\n  summary: ai.summary,\n  possible_condition: ai.possible_condition,\n  severity: ai.severity,\n  recommended_department: ai.recommended_department,\n  recommended_tests: ai.recommended_tests,\n  recommendation: ai.recommendation\n};"
      },
      "id": "b6656a9b-31ee-4cbc-aa45-4d7fecca5fd1",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        96
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Generate a unique report ID\n\nconst reportId =\n  \"REP_\" +\n  Date.now() +\n  \"_\" +\n  Math.floor(Math.random() * 1000000);\n\nreturn {\n  json: {\n    ...$json,\n    report_id: reportId,\n  },\n};"
      },
      "id": "119728a5-455a-4c36-9f93-612f993fcd5e",
