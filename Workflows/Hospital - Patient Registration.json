      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Hospital Registration Successful",
        "message": "=<h2>🏥 Hospital Registration Successful</h2>\n\n<p>Hello <b>{{$json.full_name}}</b>,</p>\n\n<p>Your registration has been completed successfully.</p>\n\n<p><b>Patient ID:</b> {{$json.patient_id}}</p>\n\n<hr>\n\n<h3>🤖 AI Preliminary Health Assessment</h3>\n\n<p><b>Possible Condition:</b> {{$json.possible_condition}}</p>\n\n<p><b>Severity:</b> {{$json.severity}}</p>\n\n<p><b>Recommended Department:</b> {{$json.recommended_department}}</p>\n\n<p><b>Recommendation:</b> {{$json.recommendation}}</p>\n\n<p><i>This assessment is AI-generated and is not a medical diagnosis.</i></p>\n\n<hr>\n\n<p><b>📅 Book Your Appointment</b></p>\n\n<p>\nTo schedule your doctor appointment, please click the link below:\n</p>\n\n<p>\n<a href=\"YOUR_APPOINTMENT_LINK\">\nhttps://geetika045.app.n8n.cloud/form/b8f75dc7-0457-4eb3-a90c-16be56e43f02\n</a>\n</p>\n\n<hr>\n\n<p>\nRegards,<br>\n<b>Hospital Management Team</b>\n</p>",
