    {
      "parameters": {
        "jsCode": "const ai = JSON.parse($node[\"Message a model\"].json.content.parts[0].text);\n\n// Generate a unique patient ID\nconst patientId = \"PAT\" + Date.now() + Math.floor(Math.random() * 1000);\n\n// Original form data\nconst form = $node[\"On form submission\"].json;\n\nreturn [\n  {\n    json: {\n      patient_id: patientId,\n\n      full_name: form.full_name,\n      age: form.age,\n      gender: form.gender,\n      email: form.email,\n      phone: form.phone,\n      address: form.Address,\n      blood_group: form.blood_group,\n      emergency_contact: form.emergency_contact,\n\n      symptoms: form.symptoms,\n      duration: form.Duration,\n      pain_level: form.Pain_Level,\n      medical_history: form.medical_history,\n      allergies: form.allergies,\n      medications: form.medications,\n\n      possible_condition: ai.possible_condition,\n      severity: ai.severity,\n      recommended_department: ai.recommended_department,\n      recommendation: ai.recommendation,\n      ai_analysis: JSON.stringify(ai)\n    }\n  }\n];"
      },
