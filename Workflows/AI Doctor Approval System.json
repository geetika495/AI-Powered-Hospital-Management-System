    {
      "parameters": {
        "sendTo": "={{$('Get Reminder Record').item.json.email}}",
        "subject": "Your Care Plan Has Been Approved",
        "message": "=<div style=\"font-family:Arial,sans-serif;color:#333;max-width:600px;margin:auto;\"><h2 style=\"color:#2e7d32;\">Your Care Plan Has Been Approved</h2><p>Dear {{ $('Get Reminder Record').item.json.patient_name }},</p><p>Your care plan has been reviewed and <strong>approved</strong> by your doctor.</p><table style=\"width:100%;border-collapse:collapse;\"><tr><td style=\"padding:8px;border-bottom:1px solid #eee;\"><strong>Doctor</strong></td><td style=\"padding:8px;border-bottom:1px solid #eee;\">{{ $('Doctor Approval Form').item.json['Doctor Name'] }}</td></tr><tr><td style=\"padding:8px;border-bottom:1px solid #eee;\"><strong>Approved Care Plan</strong></td><td style=\"padding:8px;border-bottom:1px solid #eee;\">{{ $('Get Reminder Record').item.json.ai_care_plan }}</td></tr><tr><td style=\"padding:8px;border-bottom:1px solid #eee;\"><strong>Diet Advice</strong></td><td style=\"padding:8px;border-bottom:1px solid #eee;\">{{ $('Get Reminder Record').item.json.diet_advice }}</td></tr><tr><td style=\"padding:8px;border-bottom:1px solid #eee;\"><strong>Exercise Advice</strong></td><td style=\"padding:8px;border-bottom:1px solid #eee;\">{{ $('Get Reminder Record').item.json.exercise_advice }}</td></tr><tr><td style=\"padding:8px;border-bottom:1px solid #eee;\"><strong>Precautions</strong></td><td style=\"padding:8px;border-bottom:1px solid #eee;\">{{ $('Get Reminder Record').item.json.precautions }}</td></tr><tr><td style=\"padding:8px;border-bottom:1px solid #eee;\"><strong>Follow-up Date</strong></td><td style=\"padding:8px;border-bottom:1px solid #eee;\">{{ $('Get Reminder Record').item.json.followup_date }}</td></tr><tr><td style=\"padding:8px;border-bottom:1px solid #eee;\"><strong>Doctor Comments</strong></td><td style=\"padding:8px;border-bottom:1px solid #eee;\">{{ $('Doctor Approval Form').item.json['Doctor Comments'] }}</td></tr></table><p style=\"margin-top:20px;\">Please follow the plan above and contact your clinic if you have any questions.</p><p>Warm regards,<br/>Your Care Team</p></div>",
        "options": {}
      },
