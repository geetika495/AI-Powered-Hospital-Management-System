    {
      "parameters": {
        "promptType": "define",
        "text": "=You are an AI Clinical Decision Support Assistant working inside a hospital.\n\nYour role is ONLY to assist the doctor.\n\nPatient Name:\n{{ $('Get Reminder Record').item.json.patient_name }}\n\nAge:\n{{ $('Get Reminder Record').item.json.age }}\n\nGender:\n{{ $('Get Reminder Record').item.json.gender }}\n\nDiagnosis:\n{{ $('Get Latest Medical Report').item.json.diagnosis }}\n\nSeverity:\n{{ $('Get Latest Medical Report').item.json.severity }}\n\nAI Medical Summary:\n{{ $('Get Latest Medical Report').item.json.ai_summary }}\n\nDoctor Decision:\n{{ $('Doctor Approval Form').item.json[\"Approval Decision\"] }}\n\nDoctor Comments:\n{{ $('Doctor Approval Form').item.json[\"Doctor Comments\"] }}\n\nReturn ONLY JSON.\n\n{\n  \"ai_recommendation\":\"\",\n  \"ai_confidence\":\"\",\n  \"ai_reason\":\"\",\n  \"risk_level\":\"\",\n  \"patient_advice\":\"\"\n}",
        "messages": {
          "messageValues": [
            {
              "message": "You are a professional Clinical Decision Support AI. Never prescribe medicines. Only provide recommendations for the doctor. Return valid JSON only."
            }
          ]
        },
        "batching": {}
      },
