    {
      "parameters": {
        "jsCode": "const consultation = Number($('On form submission').item.json['Consultation Fee']);\nconst lab = Number($('On form submission').item.json['Lab Charges']);\nconst medicine = Number($('On form submission').item.json['Medicine Charges']);\nconst misc = Number($('On form submission').item.json['Miscellaneous Charges']);\n\nconst subtotal = consultation + lab + medicine + misc;\n\nconst gst = subtotal * 0.18;\n\nconst total = subtotal + gst;\n\nreturn [{\njson:{\nconsultation_fee: consultation,\nlab_fee: lab,\nmedicine_fee: medicine,\nmiscellaneous_fee: misc,\ngst: gst.toFixed(2),\ntotal_amount: total.toFixed(2)\n}\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -112,
        0
      ],
      "id": "a99c1348-ac7d-43b6-91a7-fc0a58d7ca02",
      "name": "Calculate Bill"
    },
    {
      "parameters": {
        "jsCode": "return [{\njson:{\ninvoice_id: \"INV-\" + Date.now()\n}\n}];"
      },
      "type": "n8n-nodes-base.code",
