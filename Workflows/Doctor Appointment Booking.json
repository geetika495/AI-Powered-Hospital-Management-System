    {
      "parameters": {
        "jsCode": "const slots = $(\"Get Available Slot\").all().map(item => item.json);\n\nconst form = $(\"On form submission\").first().json;\n\nconst requestedTime = form.appointment_time;\n\n// Hospital slot order\nconst slotOrder = [\n  \"09:00 AM\",\n  \"10:00 AM\",\n  \"11:00 AM\",\n  \"12:00 PM\",\n  \"02:00 PM\",\n  \"03:00 PM\",\n  \"04:00 PM\",\n  \"05:00 PM\"\n];\n\nconst requestedIndex = slotOrder.indexOf(requestedTime);\n\n// Find the first slot at or after the requested time\nconst selectedSlot = slots.find(slot => {\n  return slotOrder.indexOf(slot.slot_time) >= requestedIndex;\n});\n\nif (!selectedSlot) {\n\n  return [{\n    json: {\n      status: \"Waitlisted\",\n      doctor_id: null,\n      doctor_name: null,\n      slot_id: null,\n      appointment_date: form.appointment_date,\n      appointment_time: requestedTime,\n      department: $(\"Parse AI Response\").first().json.department\n    }\n  }];\n\n}\n\nreturn [{\n  json: {\n    status: \"Booked\",\n\n    slot_id: selectedSlot.slot_id,\n\n    doctor_id: selectedSlot.doctor_id,\n\n    doctor_name: selectedSlot.doctor_name,\n\n    department: selectedSlot.department,\n\n    appointment_date: selectedSlot.slot_date,\n\n    appointment_time: selectedSlot.slot_time\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
