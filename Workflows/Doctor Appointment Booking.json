    {
      "parameters": {
        "jsCode": "const response = $json.content.parts[0].text;\n\nconst cleaned = response\n.replace(/```json/g, \"\")\n.replace(/```/g, \"\")\n.trim();\n\nconst ai = JSON.parse(cleaned);\n\nreturn [{\njson:{\npossible_condition: ai.possible_condition,\ndepartment: ai.department,\npriority: ai.priority\n}\n}];"
      },
      "id": "174f00dc-eb39-465c-9e13-6194e9eaaff7",
      "name": "Parse AI Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        976,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const form = $node[\"On form submission\"].json;\nconst ai = $node[\"Parse AI Response\"].json;\nconst patient = $node[\"Get Patient\"].json;\nconst scheduler = $node[\"Smart Scheduler\"].json;\n\nconst appointmentId =\n  \"APT\" + Date.now() + Math.floor(Math.random() * 1000);\n\nreturn [{\n  json: {\n    appointment_id: appointmentId,\n\n    patient_id: patient.patient_id,\n    patient_name: patient.full_name,\n    email: patient.email,\n\n    symptoms: form.symptoms,\n\n    appointment_date: scheduler.appointment_date,\n    appointment_time: scheduler.appointment_time,\n\n    department: scheduler.department,\n\n    doctor_id: scheduler.doctor_id,\n    doctor: scheduler.doctor_name,\n\n    possible_condition: ai.possible_condition,\n    priority: ai.priority,\n\n    ai_analysis: JSON.stringify(ai),\n\n    status: scheduler.status\n  }\n}];"
      },
