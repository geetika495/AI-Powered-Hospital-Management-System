    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "Appointment Confirmed",
        "message": "=<h2>Appointment Confirmed</h2>  <p>Hello <b>{{$json.patient_name}}</b>,</p>  <p>Your appointment has been booked successfully.</p>  <hr>  <b>Appointment ID:</b> {{$json.appointment_id}}  <br><br>  <b>Date:</b> {{$json.appointment_date}}  <br><br>  <b>Time:</b> {{$json.appointment_time}}  <br><br>  <b>Department:</b> {{$json.department}}  <br><br>  <b>Doctor:</b> {{$json.doctor}}  <hr>  <h3>AI Preliminary Assessment</h3>  <b>Possible Condition:</b> {{$json.ai_analysis}}  <hr>  Please arrive 15 minutes before your appointment.\nCLICK HERE FOR THE AI MEDICAL REPORT \nhttps://geetika045.app.n8n.cloud/form/3b7cae77-08c7-471a-8494-abc7d73ec4a3<br><br>  Regards,  AI Hospital Management Team",
        "options": {}
