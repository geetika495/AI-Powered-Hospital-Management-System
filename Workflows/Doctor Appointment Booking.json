        "messages": {
          "values": [
            {
              "content": "=You are an AI hospital triage assistant.\n\nPatient Name:\n{{$node[\"On form submission\"].json.patient_name}}\n\nSymptoms:\n{{$node[\"On form submission\"].json.symptoms}}\n\nBased on the symptoms, determine:\n\n1. Possible condition\n2. Recommended department\n3. Priority (Low, Medium, High)\n\nReturn ONLY valid JSON.\n\n{\n  \"possible_condition\":\"\",\n  \"department\":\"\",\n  \"priority\":\"\"\n}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "id": "004619ce-f5bf-4a1b-9a5a-672f941fed16",
