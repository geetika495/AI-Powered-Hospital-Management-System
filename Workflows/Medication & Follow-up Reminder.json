      "id": "ab7f59dd-ab17-42aa-bbd7-6799795070e6",
      "name": "Parse Care Plan JSON"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Create a unique reminder ID\nconst reminderId =\n  \"REM_\" +\n  Date.now() +\n  \"_\" +\n  Math.random()\n    .toString(36)\n    .substring(2,8)\n    .toUpperCase();\n\n// Keep all previous AI fields\nreturn {\n  json: {\n    ...$json,\n    reminder_id: reminderId,\n    status: \"Pending Approval\",\n    created_at: new Date().toISOString()\n  }\n};"
      },
